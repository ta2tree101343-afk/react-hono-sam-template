# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# TanStack Router auto-generated route tree — INTENTIONALLY COMMITTED
# so that fresh clones and CI can run `pnpm typecheck` without first launching
# Vite. The Router plugin regenerates this on `pnpm dev` / `pnpm build`, so
# it stays in sync during normal development. Uncomment the next line if you
# prefer to gitignore it (in which case, add a `tsr generate` step in CI).
# apps/web/src/routeTree.gen.ts

# AWS SAM
.aws-sam/
samconfig.local.toml

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Test / coverage
coverage/
