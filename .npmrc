# Fail `pnpm install` if the running Node version does not satisfy
# `engines.node` in package.json (currently `>=24 <25`).
# This surfaces version mismatches immediately instead of during runtime.
engine-strict=true

# Wait 7 days before resolving newly published package versions.
# Mirrors pnpm-workspace.yaml `minimumReleaseAge: 10080` (7 days in minutes)
# for defense-in-depth when npm is used directly (e.g. by SAM's esbuild builder,
# which installs apps/api/src/package.json via npm).
min-release-age=7
