{
	"name": "@app/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./app-type": {
			"types": "./dist/app.d.ts"
		},
		"./schemas": {
			"types": "./dist/schemas/index.d.ts"
		}
	},
	"scripts": {
		"dev": "concurrently -n handler,types -c blue,magenta \"tsx watch src/handler/index.ts\" \"tsc --emitDeclarationOnly --watch --preserveWatchOutput\"",
		"dev:handler": "tsx watch src/handler/index.ts",
		"build": "esbuild src/handler/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --external:@aws-sdk/*",
		"build:types": "tsc --emitDeclarationOnly",
		"watch:types": "tsc --emitDeclarationOnly --watch --preserveWatchOutput",
		"typecheck": "tsc --noEmit",
		"sam:dev": "sam local start-api --config-env local",
		"sam:build": "sam build",
		"sam:deploy": "sam deploy --config-env prod"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1079.0",
		"@aws-sdk/lib-dynamodb": "^3.1079.0",
		"@hono/node-server": "^2.0.8",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.4.0",
		"@scalar/hono-api-reference": "^0.11.8",
		"dotenv": "^17.4.2",
		"hono": "^4.12.27",
		"pino": "^10.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^24.13.2",
		"concurrently": "^10.0.3",
		"esbuild": "^0.28.1",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.22.5",
		"typescript": "~7.0.2"
	}
}
