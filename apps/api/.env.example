# Server
PORT=3000
NODE_ENV=development

# Basic Auth (dev only, replace with proper auth in production)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=password

# DynamoDB
USERS_TABLE_NAME=users-local
AWS_REGION=ap-northeast-1

# DynamoDB Local (Docker) endpoint.
# Comment this out to point to real AWS DynamoDB.
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# AWS credentials for the SDK.
# For DynamoDB Local: any dummy values work (Local does not validate them).
# For real AWS: leave these blank and use `aws sso login` / IAM role.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
